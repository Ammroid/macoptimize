        for (( i=0; i<${#LARGE_NAMES[@]}; i++ )); do
            local m="  "
            if (( i == sel )); then m="${BOLD}›${NC} "; fi
            local ck=" "
            if [[ "${lf_checked[$i]}" == "1" ]]; then ck="${GREEN}✓${NC}"; fi

            local display_name="${LARGE_NAMES[$i]}"
            if (( ${#display_name} > 32 )); then
                display_name="${display_name:0:29}..."
            fi

            printf "  %b[%b] %-32b %8s  %s\n" \
                "$m" "$ck" "$display_name" \
                "$(_kb_to_human "${LARGE_SIZES[$i]}")" \
                "${LARGE_AGES[$i]}"
        done

        echo ""
        echo -e "  ${DIM}Path:${NC} ${LARGE_PATHS[$sel]}"
        echo ""
        echo -e "  ${AMBER}↑↓${NC} move  ${AMBER}space${NC} select  ${AMBER}d${NC} delete selected  ${AMBER}o${NC} open in Finder  ${AMBER}q${NC} back"

        IFS= read -rsn1 key
        case "$key" in
            $'\x1b')
                read -rsn2 -t 0.1 key
                case "$key" in
                    '[A') (( sel > 0 )) && sel=$((sel - 1)) ;;
                    '[B') (( sel < ${#LARGE_NAMES[@]} - 1 )) && sel=$((sel + 1)) ;;
                esac
                ;;
            ' ')
                if [[ "${lf_checked[$sel]}" == "0" ]]; then
                    lf_checked[$sel]="1"
                else
                    lf_checked[$sel]="0"
                fi
                ;;
            'o'|'O')
                open "$(dirname "${LARGE_PATHS[$sel]}")" 2>/dev/null
                ;;
            'd'|'D')
                local del_count=0
                local del_kb=0
                for (( i=0; i<${#lf_checked[@]}; i++ )); do
                    if [[ "${lf_checked[$i]}" == "1" ]]; then
                        del_count=$((del_count + 1))
                        del_kb=$((del_kb + LARGE_SIZES[i]))
                    fi
                done
                if (( del_count > 0 )); then
                    echo ""
                    echo -e "  ${RED}⚠ These are NOT cache files. Deletion is permanent.${NC}"
                    read -rp "  Delete $del_count file(s) ($(_kb_to_human $del_kb))? [y/N] " ans
                    if [[ "$ans" =~ ^[Yy] ]]; then
                        for (( i=${#lf_checked[@]}-1; i>=0; i-- )); do
                            if [[ "${lf_checked[$i]}" == "1" ]]; then
                                rm -f "${LARGE_PATHS[$i]}" 2>/dev/null
                                echo -e "  ${GREEN}✓${NC} Deleted ${LARGE_NAMES[$i]}"
                            fi
                        done
                        read -rsn1 -p "  Press any key..."
                        # Rescan
                        _scan_large_files
                        if (( ${#LARGE_NAMES[@]} == 0 )); then
                            lf_running=0
                        else
                            lf_checked=()
                            for (( i=0; i<${#LARGE_NAMES[@]}; i++ )); do lf_checked+=("0"); done
                            sel=0
                        fi
                    fi
                fi
                ;;
            'q'|'Q') lf_running=0 ;;
        esac
    done
}

cmd_storage() {
    # Non-interactive mode (for piping / scripting)
    if [[ "${1:-}" == "--report" ]]; then
        _storage_scan
        print_header "Storage Report"

        local disk_pct
        disk_pct=$(df -h / | tail -1 | awk '{print $5}' | tr -d '%')
        local disk_free
        disk_free=$(df -h / | tail -1 | awk '{print $4}')
        local disk_total
        disk_total=$(df -h / | tail -1 | awk '{print $2}')

        echo -e "  Disk: ${disk_pct}% used  │  ${disk_free} free of ${disk_total}"
        if (( disk_pct > 90 )); then
            bad "LOW STORAGE — apps may crash"
        elif (( disk_pct > 75 )); then
            warn "Storage getting low"
        else
            ok "Storage is healthy"
        fi

        echo ""
        print_section "Cleanable Items"
        for (( i=0; i<${#SCAN_NAMES[@]}; i++ )); do
            local icon="🟢"
            if [[ "${SCAN_SAFETY[$i]}" == "yellow" ]]; then icon="🟡"; fi
            printf "  %s %-35s %8s\n" "$icon" "${SCAN_NAMES[$i]}" "$(_kb_to_human "${SCAN_SIZES[$i]}")"
        done

        echo ""
        return
    fi

    # Quick check mode (for .zshrc)
    if [[ "${1:-}" == "--quick" ]]; then
        local disk_pct
        disk_pct=$(df -h / | tail -1 | awk '{print $5}' | tr -d '%')
        local disk_free
        disk_free=$(df -h / | tail -1 | awk '{print $4}')
        if (( disk_pct > 90 )); then
            echo -e "${RED}⚠ LOW STORAGE: ${disk_free} free (${disk_pct}% used) — run 'macoptimize storage' to clean up${NC}"
        elif (( disk_pct > 80 )); then
            echo -e "${YELLOW}💾 Storage: ${disk_free} free (${disk_pct}% used)${NC}"
        fi
        return
    fi

    # Interactive TUI mode (default)
    echo -e "${AMBER}Scanning storage...${NC}"
    _storage_scan
    _scan_large_files
    _tui_storage_main
}

# ─── Other Commands ───────────────────────────────────────────────────────────

cmd_kill_devservers() {
    print_header "Kill Orphaned Dev Servers"

    local patterns=("webpack" "vite" "next-server" "expo" "metro" "flutter_tools" "gradle" "ng serve" "react-scripts")
    for pattern in "${patterns[@]}"; do
        local pids
        pids=$(pgrep -f "$pattern" 2>/dev/null || true)
        if [[ -n "$pids" ]]; then
            warn "Found '${pattern}' processes: $pids"
            read -rp "  Kill them? [y/N] " ans
            if [[ "$ans" =~ ^[Yy] ]]; then
                echo "$pids" | xargs kill 2>/dev/null
                ok "Killed ${pattern} processes"
            fi
        fi
    done
    ok "Done scanning for dev servers"
    echo ""
}

cmd_monitor() {
    print_header "Live System Monitor (Ctrl+C to stop)"
    echo ""

    while true; do
        clear
        echo -e "${BOLD}${CYAN}macoptimize monitor${NC} - $(date '+%H:%M:%S')  (Ctrl+C to stop)"
        echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

        # CPU
        local cpu_usage
        cpu_usage=$(ps -A -o %cpu | awk '{s+=$1} END {printf "%.1f", s}')
        local cpu_count
        cpu_count=$(sysctl -n hw.ncpu)
        local cpu_pct
        cpu_pct=$(echo "scale=1; $cpu_usage / $cpu_count" | bc)
        echo -e "\n  ${BOLD}CPU:${NC} ${cpu_pct}% avg/core  (${cpu_usage}% total across ${cpu_count} cores)"

        # Memory
        local mem_free
        mem_free=$(memory_pressure 2>/dev/null | grep "System-wide memory free percentage" | awk '{print $NF}' || echo "?%")
        echo -e "  ${BOLD}MEM:${NC} ${mem_free} free"

        # Swap
        local swap
        swap=$(sysctl -n vm.swapusage 2>/dev/null | awk -F'used = ' '{print $2}' | awk '{print $1}')
        echo -e "  ${BOLD}SWAP:${NC} ${swap:-unknown} used"

        # Thermal
        local therm
        therm=$(pmset -g therm 2>/dev/null | grep "CPU_Speed_Limit" | awk '{print $NF}')
        if [[ -n "$therm" ]] && (( therm < 100 )); then
            echo -e "  ${BOLD}THERMAL:${NC} ${RED}Throttled to ${therm}%${NC}"
        else
            echo -e "  ${BOLD}THERMAL:${NC} ${GREEN}OK${NC}"
        fi

        # Top 5 CPU
        echo -e "\n  ${BOLD}Top CPU:${NC}"
        ps -eo pid,%cpu,%mem,comm | sort -k2 -rn | head -5 | awk '{printf "    %-5s %-6s %-6s %s\n", $1, $2"%", $3"%", $4}'

        # Top 5 MEM
        echo -e "\n  ${BOLD}Top MEM:${NC}"
        ps -eo pid,%cpu,%mem,comm | sort -k3 -rn | head -5 | awk '{printf "    %-5s %-6s %-6s %s\n", $1, $2"%", $3"%", $4}'

        sleep 3
    done
}

cmd_quick() {
    print_header "Quick Optimization (Safe Actions)"

    info "Flushing DNS cache..."
    sudo dscacheutil -flushcache 2>/dev/null && sudo killall -HUP mDNSResponder 2>/dev/null && ok "DNS cache flushed" || warn "DNS flush needs sudo"

    info "Purging memory cache..."
    sudo purge 2>/dev/null && ok "Memory cache purged" || warn "Purge needs sudo"

    info "Clearing font caches..."
    sudo atsutil databases -remove 2>/dev/null && ok "Font caches cleared" || warn "Font cache clear needs sudo"

    info "Restarting Finder..."
    killall Finder 2>/dev/null && ok "Finder restarted" || true

    info "Restarting Dock..."
    killall Dock 2>/dev/null && ok "Dock restarted" || true

    info "Clearing temporary files..."
    rm -rf /tmp/com.apple.* 2>/dev/null || true
    rm -rf ~/Library/Caches/com.apple.dt.Xcode/Downloads/* 2>/dev/null || true
    ok "Temp files cleaned"

    echo ""
    ok "Quick optimization complete! Run 'macoptimize status' to see current health."
    echo ""
}

