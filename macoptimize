cmd_all() {
    cmd_status
    cmd_hogs
    cmd_dev
}

# ─── Main ─────────────────────────────────────────────────────────────────────

case "${1:-help}" in
    status)          cmd_status ;;
    hogs)            cmd_hogs ;;
    monitor)         cmd_monitor ;;
    storage)         cmd_storage "${2:-}" ;;
    clean)           cmd_clean ;;
    optimize)        cmd_optimize ;;
    quick)           cmd_quick ;;
    dev)             cmd_dev ;;
    kill-devservers) cmd_kill_devservers ;;
    all)             cmd_all ;;
    help|--help|-h)  cmd_help ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        cmd_help
        exit 1
        ;;
esac
